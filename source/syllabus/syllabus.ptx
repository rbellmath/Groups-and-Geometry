  <!-- Other subsections for larger dividers -->
  <subsection xml:id="sec-assessments">
    <title>Assessments and Grades</title>

    <p>Grades will be determined using the following
    summative assessments.
      <dl>
        <li>
          <title>Short Quizzes (30%)</title>
          <p>
            Short (20 minute) quizzes will be administered
            on a regular basis during class meetings.
          </p>
        </li>

        <li>
          <title>Presentations (30%)</title>
          <p>
            Each student will give two short presentations to an
            audience of peers.
          </p>
        </li>

        <li>
          <title>Written report (40%)</title>
          <p>
            Each student will submit a written report that will be
            graded at regular intervals to assess progress and 
            improvements.
          </p>
        </li>
      </dl>
    </p>
  </subsection>
